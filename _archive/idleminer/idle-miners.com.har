          "cookies": [],
          "content": {
            "size": 28236,
            "mimeType": "application/javascript",
            "text": "/* Progress Tracker — guides players through ordered progression goals.\n\n   Reads sm_default_data.json (via smDefaultData) and the user's tracker\n   state (via smGetState). Read-only consumer — never writes smUserState.\n\n   Each stage defines a filter (which SMs count toward the goal) and a\n   target predicate (when each matching SM is \"ready\"). Stages can be\n   \"all\" (every match must be ready) or \"any1\" (one match is enough).\n   The first stage that is not yet complete is highlighted as the\n   current goal. */\n\nvar PROGRESS_STAGE_RARITY_COLORS = {\n  legendary: '#f5a623',\n  epic: '#9b59b6',\n  rare: '#3498db',\n  common: '#95a5a6',\n};\n\nfunction progressHasPassive(sm, type) {\n  if (!sm || !sm.passives) return false;\n  for (var i = 0; i < sm.passives.length; i++) {\n    if (sm.passives[i].type === type) return true;\n  }\n  return false;\n}\n\nfunction progressGetPassive(sm, type) {\n  if (!sm || !sm.passives) return null;\n  for (var i = 0; i < sm.passives.length; i++) {\n    if (sm.passives[i].type === type) return sm.passives[i];\n  }\n  return null;\n}\n\n/* For the legendary mineshaft income stage: pick the MIF passive first,\n   fall back to CIF. The user's \"the level and promo when you get the\n   mif/cif\" instruction means each legendary's target = the promo at\n   which its primary income passive unlocks. Both never coexist on the\n   same SM in current data. */\nfunction progressGetMifOrCif(sm) {\n  return progressGetPassive(sm, 'MIF') || progressGetPassive(sm, 'CIF');\n}\n\nfunction progressHasMifOrCif(sm) {\n  return !!progressGetMifOrCif(sm);\n}\n\nfunction progressIsMineshaftEpicP50MifCif(sm) {\n  var p = progressGetMifOrCif(sm);\n  return sm.area === 'mineshaft' && sm.rarity === 'epic' && !!p && p.promoReq === 5;\n}\n\nfunction progressIsNonLegendaryMineshaftP50Msucr(sm) {\n  var p = progressGetPassive(sm, 'MSUCR');\n  return sm.area === 'mineshaft' && sm.rarity !== 'legendary' && !!p && p.promoReq === 5;\n}\n\nfunction progressIsLegendaryMineshaftMifCif(sm) {\n  return sm.area === 'mineshaft' && sm.rarity === 'legendary' && progressHasMifOrCif(sm);\n}\n\nfunction progressIsLegendaryMineshaftP50Msucr(sm) {\n  var p = progressGetPassive(sm, 'MSUCR');\n  return sm.area === 'mineshaft' && sm.rarity === 'legendary' && !!p && p.promoReq === 5;\n}\n\nfunction progressIsRemainingMineshaftMifCif(sm) {\n  var p = progressGetMifOrCif(sm);\n  var msucr = progressGetPassive(sm, 'MSUCR');\n  if (!p || sm.area !== 'mineshaft') return false;\n  if (progressIsMineshaftEpicP50MifCif(sm)) return false;\n  if (progressIsLegendaryMineshaftMifCif(sm)) return false;\n  if (msucr && msucr.promoReq === 5) return false;\n  return true;\n}\n\nfunction progressIsRemainingMsucr(sm) {\n  var p = progressGetPassive(sm, 'MSUCR');\n  if (!p) return false;\n  if (progressIsNonLegendaryMineshaftP50Msucr(sm)) return false;\n  if (progressIsLegendaryMineshaftP50Msucr(sm)) return false;\n  if (sm.area === 'mineshaft' && progressHasMifOrCif(sm)) return false;\n  return true;\n}\n\n/* Promo predicate — \"promoted >= n\" used by most stages. Returns false\n   for locked SMs so the checklist row reads as ✕ (locked) rather than\n   \"almost there\". Rentals (maxLevel < n*10) are auto-maxed on unlock by\n   sm-tracker.js, so \"unlocked\" is the best a player can achieve — count\n   them as ready to keep stages completable. */\nfunction progressPromoTarget(n) {\n  return function (sm, st) {\n    if (!st || !st.unlocked) return false;\n    if (sm && sm.maxLevel && Math.floor(sm.maxLevel / 10) < n) return true;\n    return (st.promoted || 0) >= n;\n  };\n}\n\n/* PROGRESS_STAGES — the preset stage definitions — lives in\n   progress-tracker-stages.js, loaded immediately after this file (see init.js).\n   Split out to keep each source file under the line budget. */\n\nvar progressInited = false;\nvar progressExpandedOverride = {}; // {stageId: 'open' | 'closed'}\n\n/* Custom-stage extension seam. Custom progression stages are a supporter-only\n   feature living in the worker-gated static/js/supporter/progress-custom.js\n   (see its header). It registers a provider here — before this file loads (via\n   window.__progressCustomProvider) or after (via the hook below). Non-supporters\n   never load it, so the feature is invisible and this file carries no custom\n   logic; built custom stages just carry render metadata the renderer reads. */\nvar progressCustomProvider =\n  (typeof window !== 'undefined' && window.__progressCustomProvider) || null;\n\nif (typeof window !== 'undefined') {\n  window.progressRegisterCustomProvider = function (provider) {\n    progressCustomProvider = provider || null;\n    // Module loaded after a tab was already open: fold its stages in now.\n    if (progressInited && typeof smDefaultData !== 'undefined' && smDefaultData) {\n      if (provider && typeof provider.onData === 'function') provider.onData();\n      progressRenderAndTrack('supporter_module_loaded');\n    }\n  };\n}\n\nfunction progressGetStageMatches(stage) {\n  // A stage may resolve its own match list (custom stages do, in pick order).\n  if (typeof stage.resolveMatches === 'function') return stage.resolveMatches();\n  if (typeof stage.filter !== 'function' || !smDefaultData) return [];\n  var matches = [];\n  for (var i = 0; i < smDefaultData.length; i++) {\n    var sm = smDefaultData[i];\n    if (stage.filter(sm)) matches.push(sm);\n  }\n  matches.sort(function (a, b) {\n    if (a.rarity !== b.rarity) {\n      var rOrder = { legendary: 0, epic: 1, rare: 2, common: 3 };\n      var aOrder = rOrder[a.rarity];\n      var bOrder = rOrder[b.rarity];\n      return (aOrder == null ? 99 : aOrder) - (bOrder == null ? 99 : bOrder);\n    }\n    return a.name.localeCompare(b.name);\n  });\n  return matches;\n}\n\nfunction progressIsOptional(stage, smId) {\n  if (!stage.optionalIds) return false;\n  for (var i = 0; i < stage.optionalIds.length; i++) {\n    if (stage.optionalIds[i] === smId) return true;\n  }\n  return false;\n}\n\n/* Compute readiness for one stage. Returns:\n     matched     — total SMs that pass the filter (excludes optional)\n     ready       — matched SMs that meet the target\n     optionalAll — every SM in the matched set including optional ones\n     optionalReady — those optional SMs that meet the target (display only)\n     subGoals    — for stage 8 — array of { label, ready, total, isComplete }\n     isComplete  — overall stage completion\n*/\nfunction progressComputeStage(stage) {\n  var all = progressGetStageMatches(stage);\n  var matched = [];\n  var optional = [];\n  for (var i = 0; i < all.length; i++) {\n    if (progressIsOptional(stage, all[i].id)) optional.push(all[i]);\n    else matched.push(all[i]);\n  }\n\n  var subGoals = null;\n  var ready = [];\n  var isComplete = false;\n\n  if (stage.subGoals && stage.subGoals.length) {\n    subGoals = stage.subGoals.map(function (g) {\n      var rdy = matched.filter(function (sm) {\n        return g.target(sm, smGetState(sm.id));\n      });\n      return {\n        label: g.label,\n        targetLabel: g.targetLabel || '',\n        ready: rdy,\n        total: matched.length,\n        isComplete: matched.length > 0 && rdy.length === matched.length,\n      };\n    });\n    isComplete = subGoals.every(function (g) {\n      return g.isComplete;\n    });\n    // For top-level \"ready\" count we use the LAST sub-goal — that's the\n    // strictest target and the one users care about most.\n    ready = subGoals[subGoals.length - 1].ready;\n  } else if (typeof stage.target === 'function') {\n    ready = matched.filter(function (sm) {\n      return stage.target(sm, smGetState(sm.id));\n    });\n    if (stage.quantifier === 'any1') {\n      isComplete = ready.length >= 1;\n    } else {\n      isComplete = matched.length > 0 && ready.length === matched.length;\n    }\n  }\n\n  var optionalReady = optional.filter(function (sm) {\n    return stage.target ? stage.target(sm, smGetState(sm.id)) : false;\n  });\n\n  return {\n    stage: stage,\n    matched: matched,\n    optional: optional,\n    ready: ready,\n    optionalReady: optionalReady,\n    subGoals: subGoals,\n    isComplete: isComplete,\n  };\n}\n\nfunction progressComputeAll() {\n  // The supporter provider (if any) contributes custom stages, rendered BEFORE\n  // the presets. Non-supporters have no provider, so only presets show.\n  var stages = [];\n  if (progressCustomProvider && typeof progressCustomProvider.stages === 'function') {\n    var extra = progressCustomProvider.stages() || [];\n    for (var i = 0; i < extra.length; i++) stages.push(extra[i]);\n  }\n  for (var j = 0; j < PROGRESS_STAGES.length; j++) {\n    stages.push(PROGRESS_STAGES[j]);\n  }\n  return stages.map(progressComputeStage);\n}\n\nfunction progressFindCurrentStageId(infos) {\n  for (var i = 0; i < infos.length; i++) {\n    if (!infos[i].isComplete) return infos[i].stage.id;\n  }\n  return null;\n}\n\nfunction progressStatusFor(infoIndex, infos, currentId) {\n  var info = infos[infoIndex];\n  if (info.isComplete) return 'completed';\n  if (info.stage.id === currentId) return 'current';\n  return 'future';\n}\n\nfunction progressIsExpanded(stageId, defaultStatus) {\n  var override = progressExpandedOverride[stageId];\n  if (override === 'open') return true;\n  if (override === 'closed') return false;\n  // Default by status: current stages expanded; completed/future collapsed.\n  return defaultStatus === 'current';\n}\n\nfunction progressFormatTargetLabel(stage, sm) {\n  var label =\n    typeof stage.targetLabel === 'function' ? stage.targetLabel(sm) || '' : stage.targetLabel || '';\n  // Rentals (e.g. Sir Henry, maxLevel 20) top out below a stage's nominal\n  // goal — showing \"P50\" is an impossible target. Clamp the label to the\n  // SM's achievable promo ceiling (maxLevel/10 → P20). General: any SM with\n  // a maxLevel below the stage goal.\n  if (label && sm && sm.maxLevel) {\n    var m = /^P(\\d+)$/.exec(label);\n   