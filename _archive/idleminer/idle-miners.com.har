          "content": {
            "size": 12062,
            "mimeType": "text/html",
            "text": "<div class=\"tab-pane fade\" id=\"crystalplanner\" role=\"tabpanel\" aria-labelledby=\"crystal-tab\">\n  <div class=\"row mt-3\">\n    <div class=\"col-lg-4 col-md-5 mb-3\">\n      <div class=\"card\">\n        <div class=\"card-body\">\n          <h6 class=\"card-title mb-3\">Crystal Upgrade Planner</h6>\n\n          <div class=\"mb-2\">\n            <div class=\"d-flex align-items-end gap-2 mb-1\">\n              <div class=\"flex-grow-1\">\n                <label class=\"form-label form-label-sm mb-1\">Super Manager (optional)</label>\n                <select class=\"form-select form-select-sm\" id=\"crystalSmSelect\">\n                  <option value=\"\">— Select SM —</option>\n                </select>\n              </div>\n              <div style=\"min-width: 160px\">\n                <label class=\"form-label form-label-sm mb-1\"\n                  >Filter\n                  <span\n                    id=\"crystalFilterHelp\"\n                    style=\"cursor: pointer; color: var(--content-text-muted); position: relative\"\n                    >&#9432;\n                    <div\n                      id=\"crystalFilterTooltip\"\n                      style=\"\n                        display: none;\n                        position: absolute;\n                        bottom: calc(100% + 6px);\n                        right: 0;\n                        background: #222;\n                        color: #eee;\n                        padding: 8px 10px;\n                        border-radius: 6px;\n                        font-size: 0.75rem;\n                        line-height: 1.4;\n                        white-space: normal;\n                        width: 220px;\n                        z-index: 1000;\n                        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);\n                      \"\n                    >\n                      <b>Upgradeable</b> — All SMs you can level up at current rank<br /><b\n                        >All unlocked</b\n                      >\n                      — Every unlocked SM not at max level<br /><b>Can get CIF/MIF</b> — Only SMs\n                      where income passives are reachable<br /><b>Can get MSUCR</b>\n                      — Only SMs where cost reduction is reachable\n                    </div></span\n                  ></label\n                >\n                <select class=\"form-select form-select-sm\" id=\"crystalSmFilter\">\n                  <option value=\"upgradeable\">Upgradeable</option>\n                  <option value=\"all\">All unlocked</option>\n                  <option value=\"cif_mif\">Can get CIF/MIF</option>\n                  <option value=\"msucr\">Can get MSUCR</option>\n                </select>\n              </div>\n            </div>\n            <div class=\"form-text\" style=\"font-size: 0.72rem; color: var(--content-text-muted)\">\n              Auto-fills from your <strong>SM Tracker</strong> tab — set up your SMs there first.\n            </div>\n          </div>\n\n          <div class=\"mb-2\">\n            <label class=\"form-label form-label-sm mb-1\">Rarity</label>\n            <select class=\"form-select form-select-sm\" id=\"crystalRarity\">\n              <option value=\"legendary\">Legendary</option>\n              <option value=\"epic\">Epic</option>\n              <option value=\"rare\">Rare</option>\n              <option value=\"common\">Common</option>\n            </select>\n          </div>\n\n          <div class=\"crystal-range-box crystal-range-from mb-1\">\n            <div class=\"crystal-range-label\">From</div>\n            <div class=\"row g-2\">\n              <div class=\"col-6\">\n                <label class=\"form-label form-label-sm mb-1\">Level</label>\n                <input\n                  type=\"number\"\n                  class=\"form-control form-control-sm\"\n                  id=\"crystalFromLevel\"\n                  min=\"1\"\n                  max=\"49\"\n                  value=\"1\"\n                />\n              </div>\n              <div class=\"col-6\">\n                <label class=\"form-label form-label-sm mb-1\">Promo</label>\n                <select class=\"form-select form-select-sm\" id=\"crystalFromPromo\">\n                  <option value=\"0\">P0 (none)</option>\n                  <option value=\"1\">P10</option>\n                  <option value=\"2\">P20</option>\n                  <option value=\"3\">P30</option>\n                  <option value=\"4\">P40</option>\n                  <option value=\"5\">P50</option>\n                </select>\n              </div>\n            </div>\n          </div>\n          <div class=\"crystal-range-box crystal-range-to mb-2\">\n            <div class=\"crystal-range-label\">To</div>\n            <div class=\"row g-2\">\n              <div class=\"col-6\">\n                <label class=\"form-label form-label-sm mb-1\">Level</label>\n                <input\n                  type=\"number\"\n                  class=\"form-control form-control-sm\"\n                  id=\"crystalToLevel\"\n                  min=\"2\"\n                  max=\"50\"\n                  value=\"50\"\n                />\n              </div>\n              <div class=\"col-6\">\n                <label class=\"form-label form-label-sm mb-1\">Promo</label>\n                <select class=\"form-select form-select-sm\" id=\"crystalTargetPromo\">\n                  <option value=\"0\">P0 (none)</option>\n                  <option value=\"1\">P10</option>\n                  <option value=\"2\">P20</option>\n                  <option value=\"3\">P30</option>\n                  <option value=\"4\">P40</option>\n                  <option value=\"5\" selected>P50</option>\n                </select>\n              </div>\n            </div>\n          </div>\n          <div id=\"crystalRankWarning\" class=\"mb-2\" style=\"display: none\">\n            <div class=\"alert alert-warning py-1 px-2 mb-0\" style=\"font-size: 0.75rem\" role=\"alert\">\n              <span id=\"crystalRankWarningText\"></span>\n            </div>\n          </div>\n\n          <hr class=\"my-2\" />\n          <p class=\"text-muted mb-2\" style=\"font-size: 0.75rem\">\n            Max cost cap — auto-applies discount crystals to keep each level under this amount.\n          </p>\n\n          <div class=\"mb-2\">\n            <div class=\"form-check form-check-inline\">\n              <input class=\"form-check-input\" type=\"checkbox\" id=\"crystalBlueCapToggle\" />\n              <label class=\"form-check-label\" style=\"font-size: 0.85rem\">Blue cap</label>\n            </div>\n            <div class=\"input-group input-group-sm mt-1\">\n              <input\n                type=\"number\"\n                class=\"form-control\"\n                id=\"crystalBlueCap\"\n                min=\"0.1\"\n                step=\"0.1\"\n                value=\"1.0\"\n                disabled\n              />\n              <span class=\"input-group-text\">M</span>\n            </div>\n          </div>\n\n          <div class=\"mb-2\">\n            <div class=\"form-check form-check-inline\">\n              <input class=\"form-check-input\" type=\"checkbox\" id=\"crystalRedCapToggle\" />\n              <label class=\"form-check-label\" style=\"font-size: 0.85rem\">Red cap</label>\n            </div>\n            <div class=\"input-group input-group-sm mt-1\">\n              <input\n                type=\"number\"\n                class=\"form-control\"\n                id=\"crystalRedCap\"\n                min=\"0.1\"\n                step=\"0.1\"\n                value=\"1.3\"\n                disabled\n              />\n              <span class=\"input-group-text\">M</span>\n            </div>\n          </div>\n\n          <hr class=\"my-2\" />\n          <p class=\"text-muted mb-2\" style=\"font-size: 0.75rem\">\n            Or set how many crystals to use — distributed optimally to most expensive levels first.\n          </p>\n\n          <div class=\"row g-2 mb-2\">\n            <div class=\"col-6\">\n              <label class=\"form-label form-label-sm mb-1\"\n                ><img\n                  class=\"crystal-icon\"\n                  src=\"../static/sprites/items/BlueCrystal.webp\"\n                  alt=\"\"\n                />Blue crystals to use</label\n              >\n              <div class=\"input-group input-group-sm\">\n                <button\n                  class=\"btn btn-outline-secondary crystal-budget-btn\"\n                  type=\"button\"\n                  id=\"crystalBlueDown\"\n                >\n                  −\n                </button>\n                <input\n                  type=\"number\"\n                  class=\"form-control text-center\"\n                  id=\"crystalBlueBudget\"\n                  min=\"0\"\n                  step=\"1\"\n                  value=\"0\"\n                />\n                <button\n                  class=\"btn btn-outline-secondary crystal-budget-btn\"\n                  type=\"button\"\n                  id=\"crystalBlueUp\"\n                >\n                  +\n                </button>\n              </div>\n            </div>\n            <div class=\"col-6\">\n              <label class=\"form-label form-label-sm mb-1\"\n                ><img\n                  class=\"crystal-icon\"\n                  src=\"../static/sprites/items/RedCrystal.webp\"\n                  alt=\"\"\n                />Red crystals to use</label\n              >\n              <div class=\"input-group input-group-sm\">\n                <button\n                  class=\"btn btn-outline-secondary crystal-budget-btn\"\n                  type=\"button\"\n                  id=\"crystalRedDown\"\n                >\n                  −\n                </button>\n                <input\n                  type=\"number\"\n                  class=\"form-control text-center\"\n                  id=\"crystalRedBudget\"\n                  min=\"0\"\n                  step=\"1\"\n                  value=\"0\"\n                />\n                <button\n                  class=\"btn btn-outline-secondary crystal-budget-btn\"\n                  type=\"button\"\n                  id=\"crystalRedUp\"\n                >\n                  +\n                </button>\n              </div>\n            </div>\n          </div>\n\n          <hr class=\"my-2\" />\n          <p class=\"text-muted mb-2\" style=\"font-size: 0.75rem\">\n            ML income (per completion) &amp; starting crystals — for ML rerun estimate.\n          </p>\n\n          <div class=\"row g-2 mb-2\">\n            <div class=\"col-6\">\n              <label class=\"form-label form-label-sm mb-1\">ML Blue Income</label>\n              <input\n                type=\"number\"\n                class=\"form-control form-control-sm\"\n                id=\"crystalMlBlue\"\n                min=\"0\"\n                step=\"1000\"\n                value=\"552000\"\n              />\n            </div>\n            <div class=\"col-6\">\n              <label class=\"form-label form-label-sm mb-1\">ML Red Income</label>\n              <input\n                type=\"number\"\n                class=\"form-control form-control-sm\"\n                id=\"crystalMlRed\"\n                min=\"0\"\n                step=\"1000\"\n                value=\"137000\"\n              />\n            </div>\n          </div>\n\n          <div class=\"row g-2 mb-3\">\n            <div class=\"col-6\">\n              <label class=\"form-label form-label-sm mb-1\">Starting Blue</label>\n              <input\n                type=\"text\"\n                inputmode=\"numeric\"\n                class=\"form-control form-control-sm\"\n                id=\"crystalStartingBlue\"\n                value=\"0\"\n              />\n            </div>\n            <div class=\"col-6\">\n              <label class=\"form-label form-label-sm mb-1\">Starting Red</label>\n              <input\n                type=\"text\"\n                inputmode=\"numeric\"\n                class=\"form-control form-control-sm\"\n                id=\"crystalStartingRed\"\n                value=\"0\"\n              />\n            </div>\n          </div>\n\n          <button class=\"btn btn-primary btn-sm w-100\" id=\"crystalCalculateBtn\">Calculate</button>\n        </div>\n      </div>\n    </div>\n    <div class=\"col-lg-8 col-md-7\">\n      <div id=\"crystalResults\">\n        <div class=\"text-muted text-center py-5\" style=\"font-size: 0.9rem\">\n          Select a rarity and level range, then click Calculate to see the crystal breakdown.\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n"
          },
