          "content": {
            "size": 2211,
            "mimeType": "text/html",
            "text": "<div class=\"tab-pane fade\" id=\"tierlist\" role=\"tabpanel\" aria-labelledby=\"tierlist-tab\">\n  <div class=\"d-flex flex-wrap gap-2 mb-3 align-items-center\">\n    <button class=\"btn btn-sm btn-outline-primary\" id=\"tierlistExportBtn\">Download as PNG</button>\n    <button class=\"btn btn-sm btn-outline-danger\" id=\"tierlistResetBtn\">Reset All</button>\n    <label class=\"d-flex align-items-center gap-1 mb-0\" style=\"font-size: 0.8rem; margin-left: 8px\">\n      <input type=\"checkbox\" id=\"tierlistPlusMinus\" />\n      <span>+/- tiers</span>\n    </label>\n    <label class=\"d-flex align-items-center gap-1 mb-0\" style=\"font-size: 0.8rem; margin-left: 8px\">\n      <input type=\"checkbox\" id=\"tierlistShowExclusions\" />\n      <span>Manage exclusions</span>\n    </label>\n    <label class=\"d-flex align-items-center gap-1 mb-0\" style=\"font-size: 0.8rem; margin-left: 8px\">\n      <input type=\"checkbox\" id=\"tierlistShowNick\" checked />\n      <span>Show name:</span>\n    </label>\n    <input\n      type=\"text\"\n      class=\"form-control form-control-sm\"\n      id=\"tierlistNick\"\n      placeholder=\"Your nickname\"\n      style=\"max-width: 150px\"\n      aria-label=\"Your nickname for tier list export\"\n    />\n    <span class=\"text-muted\" style=\"font-size: 0.8rem; margin-left: 8px\">Filter:</span>\n    <select\n      class=\"form-select form-select-sm\"\n      id=\"tierlistFilterArea\"\n      style=\"max-width: 140px\"\n      aria-label=\"Filter tier list by area\"\n    >\n      <option value=\"\">All Areas</option>\n      <option value=\"mineshaft\">Mineshaft</option>\n      <option value=\"elevator\">Elevator</option>\n      <option value=\"warehouse\">Warehouse</option>\n    </select>\n    <select\n      class=\"form-select form-select-sm\"\n      id=\"tierlistFilterRarity\"\n      style=\"max-width: 140px\"\n      aria-label=\"Filter tier list by rarity\"\n    >\n      <option value=\"\">All Rarities</option>\n      <option value=\"legendary\">Legendary</option>\n      <option value=\"epic\">Epic</option>\n      <option value=\"rare\">Rare</option>\n      <option value=\"common\">Common</option>\n    </select>\n  </div>\n  <div id=\"tierlistContainer\"></div>\n  <div class=\"tierlist-pool-header mt-3 mb-1\">Unranked</div>\n  <div class=\"tierlist-pool\" id=\"tierlistPool\"></div>\n</div>\n"
          },
