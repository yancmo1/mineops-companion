            "mimeType": "text/css",
            "text": "/* --- Filter control utility classes (replacing inline styles) --- */\n.filter-select-sm {\n  max-width: 140px;\n}\n.filter-select-md {\n  max-width: 180px;\n}\n.filter-select-lg {\n  max-width: 220px;\n}\n.filter-search-wrap {\n  position: relative;\n  max-width: 200px;\n}\n\n/* Crystal Planner */\n.crystal-summary-card {\n  background: rgba(30, 30, 60, 0.7);\n  border: 1px solid rgba(255, 255, 255, 0.1);\n  border-radius: 8px;\n  padding: 10px 16px;\n  text-align: center;\n  min-width: 100px;\n}\n.crystal-summary-card.crystal-blue {\n  border-left: 3px solid var(--accent-info-bright);\n}\n.crystal-summary-card.crystal-red {\n  border-left: 3px solid var(--accent-danger-light);\n}\n.crystal-summary-card.crystal-discount {\n  border-left: 3px solid var(--accent-warning-bright);\n}\n.crystal-summary-card.crystal-time {\n  border-left: 3px solid var(--accent-success-bright);\n}\n.crystal-summary-value {\n  font-size: 1.3rem;\n  font-weight: 700;\n  color: #fff;\n}\n.crystal-summary-label {\n  font-size: 0.7rem;\n  color: rgba(255, 255, 255, 0.6);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n/* Blue/Red crystal art on summary cards + next to the blue/red input labels. */\n.crystal-icon {\n  width: 18px;\n  height: 18px;\n  vertical-align: -3px;\n  margin-right: 4px;\n}\n.crystal-summary-label .crystal-icon {\n  width: 14px;\n  height: 14px;\n  vertical-align: -2px;\n  margin-right: 3px;\n}\n.crystal-table {\n  font-size: 0.85rem;\n}\n.crystal-table th {\n  font-size: 0.75rem;\n  text-transform: uppercase;\n  color: rgba(255, 255, 255, 0.5);\n  border-bottom-width: 1px;\n}\n.crystal-table td {\n  vertical-align: middle;\n}\n.crystal-promo-row {\n  background: rgba(255, 107, 107, 0.08);\n}\n.crystal-cap-row {\n  background: rgba(255, 217, 61, 0.06);\n}\n.crystal-promo-row.crystal-cap-row {\n  background: rgba(255, 160, 80, 0.08);\n}\n.crystal-adjust-cell {\n  white-space: nowrap;\n}\n.crystal-adjust-btn {\n  width: 24px;\n  height: 24px;\n  padding: 0;\n  line-height: 22px;\n  font-size: 0.85rem;\n  border-radius: 4px;\n  background: rgba(255, 255, 255, 0.08);\n  border: 1px solid rgba(255, 255, 255, 0.15);\n  color: #ccc;\n}\n.crystal-adjust-btn:hover {\n  background: rgba(255, 255, 255, 0.15);\n  color: #fff;\n}\n.crystal-app-count {\n  display: inline-block;\n  min-width: 24px;\n  text-align: center;\n  font-weight: 600;\n}\n.crystal-range-box {\n  position: relative;\n  padding: 8px 10px 6px;\n  border-radius: 6px;\n  border: 1px solid rgba(255, 255, 255, 0.08);\n}\n.crystal-range-label {\n  position: absolute;\n  top: -8px;\n  left: 10px;\n  font-size: 0.65rem;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  padding: 0 4px;\n  line-height: 1;\n  background: var(--bs-card-bg, #1a1d21);\n}\n.crystal-range-from {\n  background: rgba(77, 166, 255, 0.05);\n  border-color: rgba(77, 166, 255, 0.2);\n}\n.crystal-range-from .crystal-range-label {\n  color: var(--accent-info-bright);\n}\n.crystal-range-to {\n  background: rgba(107, 203, 119, 0.05);\n  border-color: rgba(107, 203, 119, 0.2);\n}\n.crystal-range-to .crystal-range-label {\n  color: var(--accent-success-bright);\n}\n\n/* Essence Planner */\n.essence-summary-card {\n  background: rgba(30, 30, 60, 0.7);\n  border: 1px solid rgba(255, 255, 255, 0.1);\n  border-radius: 8px;\n  padding: 10px 16px;\n  text-align: center;\n  min-width: 100px;\n}\n.essence-summary-card.essence-sm-name {\n  border-left: 3px solid var(--accent-gold-light);\n}\n.essence-summary-card.essence-frags {\n  border-left: 3px solid var(--accent-info-bright);\n}\n.essence-summary-card.essence-total {\n  border-left: 3px solid var(--accent-success-bright);\n}\n.essence-summary-value {\n  font-size: 1.3rem;\n  font-weight: 700;\n  color: #fff;\n}\n.essence-summary-label {\n  font-size: 0.7rem;\n  color: rgba(255, 255, 255, 0.6);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n.essence-rank-card {\n  background: rgba(30, 30, 60, 0.7);\n  border: 1px solid rgba(255, 255, 255, 0.1);\n  border-radius: 8px;\n  padding: 12px;\n  margin-bottom: 12px;\n}\n.essence-rank-header {\n  font-size: 0.9rem;\n  font-weight: 700;\n  color: var(--accent-gold-light);\n  margin-bottom: 8px;\n}\n.essence-element-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 4px 0;\n  font-size: 0.85rem;\n}\n.essence-total-table {\n  font-size: 0.85rem;\n  color: #dee2e6;\n  --bs-table-bg: transparent;\n  --bs-table-color: #dee2e6;\n  --bs-table-border-color: rgba(255, 255, 255, 0.1);\n}\n.essence-total-table th {\n  font-size: 0.75rem;\n  text-transform: uppercase;\n  color: rgba(255, 255, 255, 0.5);\n  border-bottom-width: 1px;\n}\n.essence-total-table td {\n  vertical-align: middle;\n  color: #dee2e6;\n}\n.essence-total-table .essence-surplus {\n  color: var(--accent-success-bright);\n}\n.essence-total-table .essence-deficit {\n  color: var(--accent-danger-light);\n}\n.essence-surplus {\n  color: var(--accent-success-bright);\n  font-weight: 600;\n}\n.essence-deficit {\n  color: var(--accent-danger-light);\n  font-weight: 600;\n}\n.essence-rank-unaffordable {\n  opacity: 0.65;\n}\n.essence-cutoff-divider {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin: 16px 0;\n  color: var(--accent-danger-light);\n  font-size: 0.78rem;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n.essence-cutoff-divider::before,\n.essence-cutoff-divider::after {\n  content: '';\n  flex: 1;\n  height: 2px;\n  background: linear-gradient(90deg, transparent, var(--accent-danger-light), transparent);\n}\n.essence-affordable-badge {\n  background: rgba(107, 203, 119, 0.12);\n  border: 1px solid rgba(107, 203, 119, 0.3);\n  border-radius: 6px;\n  padding: 8px 14px;\n  margin-bottom: 12px;\n  font-size: 0.85rem;\n  color: var(--accent-success-bright);\n  text-align: center;\n}\n.essence-affordable-badge.essence-affordable-none {\n  background: rgba(255, 107, 107, 0.12);\n  border-color: rgba(255, 107, 107, 0.3);\n  color: var(--accent-danger-light);\n}\n\n/* --- Options tab: text size buttons --- */\n.text-size-btn.active {\n  background: var(--accent-primary);\n  color: #fff;\n  border-color: var(--accent-primary);\n}\n.text-size-btn.active:hover {\n  background: var(--accent-primary-hover);\n  border-color: var(--accent-primary-hover);\n}\n\n/* --- Card grid adjustments per text size --- */\n@media (min-width: 992px) {\n  html.ts-875 #smGrid .sm-card-col {\n    flex: 0 0 14.285%;\n    max-width: 14.285%;\n    width: 14.285%;\n  }\n  html.ts-115 #smGrid .sm-card-col {\n    flex: 0 0 20%;\n    max-width: 20%;\n    width: 20%;\n  }\n  html.ts-130 #smGrid .sm-card-col {\n    flex: 0 0 25%;\n    max-width: 25%;\n    width: 25%;\n  }\n  html.ts-150 #smGrid .sm-card-col {\n    flex: 0 0 33.333%;\n    max-width: 33.333%;\n    width: 33.333%;\n  }\n}\n@media (min-width: 768px) and (max-width: 991.98px) {\n  html.ts-875 #smGrid .sm-card-col {\n    flex: 0 0 20%;\n    max-width: 20%;\n    width: 20%;\n  }\n  html.ts-130 #smGrid .sm-card-col {\n    flex: 0 0 33.333%;\n    max-width: 33.333%;\n    width: 33.333%;\n  }\n  html.ts-150 #smGrid .sm-card-col {\n    flex: 0 0 50%;\n    max-width: 50%;\n    width: 50%;\n  }\n}\n"
          },
