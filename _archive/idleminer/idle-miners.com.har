            "mimeType": "text/css",
            "text": ".events-pane {\n  padding-top: 0.75rem;\n}\n\n.events-header {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.75rem;\n  align-items: center;\n  margin-bottom: 0.75rem;\n}\n\n.events-header h2 {\n  font-size: 1.4rem;\n  margin: 0;\n}\n\n.events-meta {\n  font-size: 0.8rem;\n  color: var(--content-text-muted, #666);\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.75rem;\n  align-items: center;\n}\n\n.events-meta .events-tz {\n  padding: 2px 8px;\n  background: var(--content-bg-alt, #f1f3f5);\n  border-radius: 12px;\n}\n\n.events-meta .events-now {\n  padding: 2px 8px;\n  background: var(--content-bg-alt, #e0f2fe);\n  color: var(--accent-info, #075985);\n  border-radius: 12px;\n  font-variant-numeric: tabular-nums;\n}\n\n.events-meta .events-stale {\n  color: var(--accent-warning, #b45309);\n  background: var(--content-bg-alt, #fef3c7);\n  padding: 2px 8px;\n  border-radius: 12px;\n}\n\n.events-filters {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  margin-bottom: 0.75rem;\n}\n\n.events-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  padding: 3px 10px;\n  border-radius: 999px;\n  font-size: 0.78rem;\n  background: var(--content-bg-alt, #f1f3f5);\n  color: var(--content-text-muted, #555);\n  border: 1px solid transparent;\n  cursor: pointer;\n  user-select: none;\n  transition:\n    background 0.1s,\n    color 0.1s;\n}\n\n.events-chip .events-chip-swatch {\n  width: 10px;\n  height: 10px;\n  border-radius: 3px;\n  display: inline-block;\n}\n\n.events-chip.on {\n  color: var(--content-text, #111);\n  background: var(--accent-primary-light, #e6f4ea);\n  border-color: var(--accent-primary, #c6e2cf);\n}\n\n.events-chip.off {\n  text-decoration: line-through;\n  opacity: 0.55;\n}\n\n.events-gantt-wrap {\n  position: relative;\n  background: var(--content-bg, #fdfdfd);\n  border: 1px solid var(--border-subtle, #e5e7eb);\n  border-radius: 8px;\n  padding: 12px 12px 0 12px;\n}\n\n.events-gantt {\n  width: 100%;\n  display: block;\n}\n\n.events-gantt .lane-bg {\n  fill: transparent;\n}\n\n.events-gantt .lane-bg.alt {\n  fill: var(--content-bg-alt, #f1f3f5);\n}\n\n.events-gantt .now-line {\n  stroke: var(--accent-danger, #e11d48);\n  stroke-width: 2;\n  stroke-dasharray: 4 3;\n}\n\n.events-gantt .now-label {\n  fill: var(--accent-danger, #e11d48);\n  font-size: 10px;\n  font-weight: 600;\n}\n\n.events-gantt .tick-line {\n  stroke: var(--border-subtle, #e5e7eb);\n  stroke-width: 1;\n}\n\n.events-gantt .tick-label {\n  fill: var(--content-text-muted, #6b7280);\n  font-size: 10px;\n}\n\n.events-gantt .lane-label {\n  fill: var(--content-text, #374151);\n  font-size: 11px;\n  font-weight: 500;\n}\n\n.events-gantt .empty-text {\n  fill: var(--content-text-muted, #6b7280);\n}\n\n.events-gantt .bar {\n  rx: 4;\n  ry: 4;\n  opacity: 0.9;\n  cursor: pointer;\n  transition: opacity 0.12s;\n}\n\n.events-gantt .bar:hover,\n.events-gantt .bar:focus {\n  opacity: 1;\n  stroke: var(--content-text, #111);\n  stroke-width: 1.5;\n  outline: none;\n}\n\n.events-gantt .bar.past {\n  opacity: 0.35;\n}\n\n.events-tooltip {\n  position: absolute;\n  pointer-events: none;\n  background: #111;\n  color: #f9fafb;\n  padding: 6px 10px;\n  border-radius: 6px;\n  font-size: 0.8rem;\n  line-height: 1.3;\n  z-index: 10;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);\n  white-space: nowrap;\n  transition: opacity 0.1s;\n  opacity: 0;\n}\n\n.events-tooltip.show {\n  opacity: 1;\n}\n\n.events-tooltip strong {\n  color: #fff;\n}\n\n.events-cards-section {\n  margin-top: 1rem;\n}\n\n.events-cards-section h3 {\n  font-size: 0.95rem;\n  color: var(--content-text, #374151);\n  margin: 0 0 0.5rem 0;\n  font-weight: 600;\n}\n\n.events-card-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));\n  gap: 8px;\n}\n\n.events-card {\n  border: 1px solid var(--border-subtle, #e5e7eb);\n  border-left-width: 4px;\n  border-radius: 6px;\n  padding: 8px 10px;\n  background: var(--content-bg, #fff);\n  color: var(--content-text, inherit);\n  font-size: 0.82rem;\n}\n\n.events-card-name {\n  font-weight: 600;\n  margin-bottom: 2px;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.events-card-times {\n  color: var(--content-text-muted, #555);\n  font-size: 0.78rem;\n}\n\n.events-card-countdown {\n  font-size: 0.72rem;\n  color: var(--content-text-muted, #6b7280);\n  margin-top: 2px;\n}\n\n.events-card.live .events-card-countdown {\n  color: var(--accent-success, #059669);\n  font-weight: 600;\n}\n\n.events-empty {\n  font-size: 0.85rem;\n  color: var(--content-text-muted, #6b7280);\n  padding: 0.5rem;\n}\n\n@media (max-width: 576px) {\n  .events-header h2 {\n    font-size: 1.15rem;\n  }\n  .events-gantt-wrap {\n    padding: 8px 6px 0 6px;\n  }\n  .events-card-grid {\n    grid-template-columns: 1fr;\n  }\n}\n"
          },
