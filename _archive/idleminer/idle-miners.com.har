            "mimeType": "text/css",
            "text": "/* Progress Tracker — ordered progression goals derived from SM Tracker state */\n\n.progress-tracker-wrap {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-md, 1rem);\n}\n\n.progress-tracker-header {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: var(--space-sm, 0.5rem);\n}\n\n.progress-tracker-summary {\n  font-size: 0.95rem;\n  color: var(--content-text-muted, #6b6259);\n}\n\n.progress-tracker-intro p {\n  font-size: 0.85rem;\n  color: var(--content-text-muted, #6b6259);\n  margin-bottom: 0;\n}\n\n.progress-stage {\n  border: 1px solid var(--content-bg-alt, #f2efe9);\n  border-radius: var(--radius-md, 12px);\n  background: var(--content-bg, #faf8f5);\n  overflow: hidden;\n  transition:\n    opacity var(--transition-normal, 0.25s ease),\n    box-shadow var(--transition-normal, 0.25s ease),\n    border-color var(--transition-normal, 0.25s ease);\n}\n\n.progress-stage-current {\n  border-color: var(--accent-primary, #4a7c59);\n  box-shadow: 0 0 0 1px var(--accent-primary, #4a7c59);\n}\n\n.progress-stage-completed {\n  opacity: 0.78;\n}\n\n.progress-stage-future {\n  opacity: 0.55;\n}\n\n.progress-stage-future:hover,\n.progress-stage-future:focus-within {\n  opacity: 0.85;\n}\n\n.progress-stage-header {\n  display: grid;\n  grid-template-columns: auto 1fr auto auto;\n  align-items: center;\n  gap: var(--space-sm, 0.5rem);\n  padding: var(--space-sm, 0.5rem) var(--space-md, 1rem);\n  cursor: pointer;\n  user-select: none;\n}\n\n.progress-stage-icon {\n  font-size: 1.3rem;\n  width: 1.6rem;\n  text-align: center;\n  color: var(--content-text-muted, #6b6259);\n}\n\n.progress-stage-completed .progress-stage-icon {\n  color: var(--accent-success, #2f9e44);\n}\n\n.progress-stage-current .progress-stage-icon {\n  color: var(--accent-primary, #4a7c59);\n}\n\n.progress-stage-titles {\n  min-width: 0;\n}\n\n.progress-stage-title {\n  font-weight: 600;\n  color: var(--content-text, #2c2519);\n  font-size: 0.95rem;\n}\n\n.progress-stage-subtitle {\n  font-size: 0.78rem;\n  color: var(--content-text-muted, #6b6259);\n  margin-top: 2px;\n}\n\n.progress-stage-meta {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-end;\n  gap: 4px;\n  min-width: 11rem;\n}\n\n.progress-stage-status {\n  font-size: 0.7rem;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n  font-weight: 700;\n  color: var(--content-text-muted, #6b6259);\n}\n\n.progress-stage-completed .progress-stage-status {\n  color: var(--accent-success, #2f9e44);\n}\n\n.progress-stage-current .progress-stage-status {\n  color: var(--accent-primary, #4a7c59);\n}\n\n.progress-stage-counts {\n  font-size: 0.78rem;\n  color: var(--content-text-muted, #6b6259);\n}\n\n.progress-stage-optional-note {\n  margin-left: 0.4em;\n  font-style: italic;\n}\n\n.progress-bar-wrap {\n  width: 11rem;\n  height: 4px;\n  background: var(--content-bg-alt, #f2efe9);\n  border-radius: var(--radius-pill, 999px);\n  overflow: hidden;\n}\n\n.progress-bar-fill {\n  height: 100%;\n  background: var(--accent-primary, #4a7c59);\n  transition: width var(--transition-normal, 0.25s ease);\n}\n\n.progress-stage-completed .progress-bar-fill {\n  background: var(--accent-success, #2f9e44);\n}\n\n.progress-stage-toggle {\n  background: transparent;\n  border: 0;\n  color: var(--content-text-muted, #6b6259);\n  font-size: 1.2rem;\n  line-height: 1;\n  padding: 4px 8px;\n  border-radius: var(--radius-sm, 6px);\n  transition: transform var(--transition-fast, 0.15s ease);\n}\n\n.progress-stage-open .progress-stage-toggle {\n  transform: rotate(180deg);\n}\n\n.progress-stage-body {\n  display: none;\n  border-top: 1px solid var(--content-bg-alt, #f2efe9);\n  padding: var(--space-sm, 0.5rem) var(--space-md, 1rem);\n}\n\n.progress-stage-open .progress-stage-body {\n  display: block;\n}\n\n.progress-stage-rows {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.progress-row {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.55em;\n  padding: 6px 8px;\n  border-radius: var(--radius-sm, 6px);\n  cursor: pointer;\n  transition: background-color var(--transition-fast, 0.15s ease);\n  font-size: 0.85rem;\n}\n\n.progress-row:hover,\n.progress-row:focus-visible {\n  background: var(--content-bg-alt, #f2efe9);\n  outline: none;\n}\n\n.progress-row-empty {\n  font-style: italic;\n  font-size: 0.85rem;\n  padding: 6px 8px;\n}\n\n.progress-row-status {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 1.4em;\n  height: 1.4em;\n  border-radius: var(--radius-pill, 999px);\n  font-size: 0.85rem;\n  font-weight: 700;\n  flex-shrink: 0;\n}\n\n.progress-row-ready .progress-row-status {\n  background: var(--accent-success, #2f9e44);\n  color: white;\n}\n\n.progress-row-partial .progress-row-status {\n  background: var(--accent-warning, #f5a623);\n  color: white;\n}\n\n.progress-row-locked .progress-row-status {\n  background: var(--content-bg-alt, #f2efe9);\n  color: var(--content-text-muted, #6b6259);\n}\n\n.progress-sm-sprite {\n  width: 1.6rem;\n  height: 1.6rem;\n  border-radius: var(--radius-sm, 6px);\n  flex-shrink: 0;\n  object-fit: cover;\n}\n\n.progress-rarity-dot {\n  display: inline-block;\n  width: 0.5rem;\n  height: 0.5rem;\n  border-radius: var(--radius-pill, 999px);\n  flex-shrink: 0;\n}\n\n.progress-row-name {\n  font-weight: 500;\n  color: var(--content-text, #2c2519);\n  flex: 1;\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.progress-row-promo {\n  font-family: var(--font-mono, monospace);\n  font-size: 0.78rem;\n  color: var(--content-text-muted, #6b6259);\n  background: var(--content-bg-alt, #f2efe9);\n  padding: 2px 6px;\n  border-radius: var(--radius-pill, 999px);\n}\n\n.progress-row-promo.locked {\n  font-style: italic;\n}\n\n.progress-row-ready .progress-row-promo {\n  color: var(--accent-success, #2f9e44);\n  background: rgba(47, 158, 68, 0.12);\n}\n\n.progress-row-locked {\n  opacity: 0.7;\n}\n\n.progress-badge {\n  font-size: 0.7rem;\n  padding: 2px 6px;\n  border-radius: var(--radius-pill, 999px);\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n}\n\n.progress-badge-optional {\n  background: var(--accent-gold-glow, rgba(212, 169, 55, 0.35));\n  color: var(--content-text, #2c2519);\n}\n\n.progress-row-optional {\n  border-left: 2px dashed var(--accent-gold, #d4a937);\n  padding-left: 6px;\n}\n\n.progress-loading {\n  padding: var(--space-md, 1rem);\n  text-align: center;\n  font-style: italic;\n}\n\n/* Brief flash highlight applied to the SM card after a deep-link click. */\n.sm-card-col.progress-sm-target-flash > .sm-card,\n.progress-sm-target-flash {\n  outline: 2px solid var(--accent-primary, #4a7c59);\n  outline-offset: 2px;\n  transition: outline-color var(--transition-normal, 0.25s ease);\n}\n\n@media (max-width: 720px) {\n  .progress-stage-header {\n    grid-template-columns: auto 1fr auto;\n    grid-template-rows: auto auto;\n  }\n  .progress-stage-meta {\n    grid-column: 1 / -1;\n    align-items: flex-start;\n    min-width: 0;\n  }\n  .progress-bar-wrap {\n    width: 100%;\n  }\n}\n"
          },
