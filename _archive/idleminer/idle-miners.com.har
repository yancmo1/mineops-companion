            "mimeType": "text/css",
            "text": "/* --- Tier List --- */\n.tierlist-row {\n  display: flex;\n  align-items: stretch;\n  margin-bottom: 2px;\n}\n.tierlist-label {\n  width: 60px;\n  min-width: 60px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-weight: 700;\n  font-size: 1.4rem;\n  color: var(--content-text);\n  border-radius: 4px 0 0 4px;\n  user-select: none;\n}\n.tierlist-items {\n  flex: 1;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 4px;\n  padding: 6px;\n  min-height: 56px;\n  background: var(--border-subtle);\n  border-radius: 0 4px 4px 0;\n  border: 1px solid var(--border-strong);\n  border-left: none;\n  transition: background 0.15s;\n}\n.tierlist-items.dragover {\n  background: rgba(74, 124, 89, 0.18);\n}\n.tierlist-pool-header {\n  font-weight: 600;\n  font-size: 0.85rem;\n  color: var(--content-text);\n  margin-top: 12px;\n  margin-bottom: 4px;\n}\n.tierlist-pool {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 4px;\n  padding: 8px;\n  min-height: 56px;\n  background: var(--border-subtle);\n  border-radius: 6px;\n  border: 1px dashed var(--border-strong);\n  transition: background 0.15s;\n}\n.tierlist-pool.dragover {\n  background: rgba(74, 124, 89, 0.18);\n}\n.tierlist-item {\n  width: 68px;\n  height: 68px;\n  border: 3px solid var(--rarity-common);\n  border-radius: 6px;\n  overflow: hidden;\n  cursor: grab;\n  transition:\n    transform 0.1s,\n    opacity 0.15s;\n  background: var(--content-bg-alt) no-repeat center center;\n  background-size: cover;\n  flex-shrink: 0;\n  /* Fixed 68x68 → exact intrinsic size, so the ~100-item pool skips off-screen\n     layout/paint with zero scroll jump. */\n  content-visibility: auto;\n  contain-intrinsic-size: 68px 68px;\n}\n.tierlist-item:hover {\n  transform: scale(1.1);\n  z-index: 1;\n}\n.tierlist-item.dragging {\n  opacity: 0.3;\n}\n.tierlist-ghost {\n  border-radius: 6px;\n  box-shadow: 0 4px 12px var(--shadow-color-strong);\n}\n\n.tierlist-plusminus .tierlist-label {\n  font-size: 1.1rem;\n}\n.tierlist-plusminus .tierlist-items {\n  min-height: 44px;\n  padding: 4px;\n  gap: 3px;\n}\n.tierlist-plusminus .tierlist-item {\n  width: 52px;\n  height: 52px;\n  border-width: 2px;\n}\n.tierlist-plusminus .tierlist-row {\n  margin-bottom: 1px;\n}\n\n@media (max-width: 767.98px) {\n  .site-title {\n    font-size: 2rem;\n    letter-spacing: 1.2px;\n    padding-top: 1rem;\n  }\n\n  .site-title .correction .handwritten {\n    font-size: 1.7rem;\n    top: -1.35em;\n  }\n\n  .site-subtitle {\n    font-size: 0.78rem;\n    letter-spacing: 1.1px;\n  }\n\n  .sm-chrono-standalone .nav-tabs {\n    flex-wrap: nowrap;\n    overflow-x: auto;\n    overflow-y: hidden;\n    padding-bottom: 0.25rem;\n    scrollbar-width: none;\n  }\n\n  .sm-chrono-standalone .nav-tabs::-webkit-scrollbar {\n    display: none;\n  }\n\n  .sm-chrono-standalone .nav-tabs .nav-link {\n    white-space: nowrap;\n  }\n\n  .sm-chrono-standalone .tab-content {\n    padding: 14px;\n    border-radius: 0 8px 8px 8px;\n  }\n\n  #chronoplanner > .d-flex.flex-wrap.gap-2.align-items-center.mb-3,\n  #tierlist > .d-flex.flex-wrap.gap-2.mb-3.align-items-center,\n  #tierlist > .d-flex.flex-wrap.gap-2.align-items-center.mt-3.mb-1 {\n    align-items: stretch !important;\n  }\n\n  #chronoplanner > .d-flex.flex-wrap.gap-2.align-items-center.mb-3 > label {\n    flex: 1 1 100%;\n    margin: 0 !important;\n  }\n\n  #chronoplanner > .d-flex.flex-wrap.gap-2.align-items-center.mb-3 > button {\n    flex: 1 1 calc(50% - 0.5rem);\n  }\n\n  #chronoPatternLen {\n    width: 4.5rem !important;\n    flex: 0 0 auto;\n  }\n\n  #chronoPatternSelects {\n    flex: 1 1 100%;\n    display: flex !important;\n    flex-wrap: wrap !important;\n    gap: 4px;\n    padding-bottom: 0;\n  }\n\n  #chronoPatternSelects .chrono-el-select {\n    flex: 0 0 auto;\n    width: 88px;\n  }\n\n  #chronoSummary {\n    flex: 1 1 100%;\n    line-height: 1.5;\n  }\n\n  #chronoplanner .row {\n    --bs-gutter-y: 0.75rem;\n  }\n\n  .chrono-grid-wrap {\n    position: static;\n    max-height: 50vh;\n    border: 1px solid var(--border-subtle);\n    border-radius: 10px;\n    background: var(--content-bg);\n  }\n\n  .chrono-slot {\n    flex-wrap: wrap;\n    align-items: flex-start;\n    gap: 4px;\n    padding: 6px 8px;\n  }\n\n  .chrono-slot-label {\n    width: 34px;\n    font-size: 0.75rem;\n  }\n\n  .chrono-el-select {\n    width: 72px;\n    font-size: 0.72rem;\n  }\n\n  .chrono-sm-badge {\n    flex: 1 1 100%;\n    white-space: normal;\n    line-height: 1.3;\n  }\n\n  .chrono-sm-badge img {\n    width: 20px;\n    height: 20px;\n  }\n\n  .chrono-panel-card {\n    flex-wrap: wrap;\n    align-items: flex-start;\n    gap: 4px;\n    padding: 6px 8px;\n  }\n\n  .chrono-panel-card > span:not(.chrono-badge) {\n    flex: 1 1 calc(100% - 30px);\n    min-width: 0;\n    line-height: 1.35;\n  }\n\n  .chrono-panel-card img {\n    width: 22px;\n    height: 22px;\n  }\n\n  .chrono-panel-card .chrono-badge {\n    flex: 1 0 100%;\n    margin-left: 30px;\n  }\n\n  #chronoBreakdownBody {\n    overflow-x: auto;\n  }\n\n  #tierlist > .d-flex.flex-wrap.gap-2.mb-3.align-items-center > button {\n    flex: 1 1 calc(50% - 0.5rem);\n  }\n\n  #tierlist > .d-flex.flex-wrap.gap-2.mb-3.align-items-center > label {\n    flex: 1 1 100%;\n    margin-left: 0 !important;\n  }\n\n  #tierlistNick {\n    flex: 1 1 100%;\n    max-width: none !important;\n  }\n\n  #tierlist > .d-flex.flex-wrap.gap-2.align-items-center.mt-3.mb-1 > span {\n    flex: 1 1 100%;\n  }\n\n  #tierlistFilterArea,\n  #tierlistFilterRarity {\n    flex: 1 1 calc(50% - 0.5rem);\n    max-width: none;\n  }\n\n  .tierlist-pool {\n    padding: 6px;\n    gap: 3px;\n  }\n}\n\n@media (max-width: 575.98px) {\n  #smGrid {\n    --bs-gutter-x: 0.5rem;\n    --bs-gutter-y: 0.5rem;\n  }\n\n  #smGrid .sm-card-col {\n    flex: 0 0 100%;\n    width: 100%;\n    max-width: 100%;\n  }\n\n  #supermanagers > .d-flex.flex-wrap.gap-2.align-items-center.mb-3 {\n    align-items: stretch !important;\n  }\n\n  #supermanagers > .d-flex.flex-wrap.gap-2.align-items-center.mb-3 > div:first-child {\n    flex: 1 1 100%;\n    max-width: none;\n  }\n\n  #supermanagers > .d-flex.flex-wrap.gap-2.align-items-center.mb-3 select.form-select-sm,\n  #supermanagers > .d-flex.flex-wrap.gap-2.align-items-center.mb-3 .form-check-inline {\n    flex: 1 1 calc(50% - 0.5rem);\n    min-width: 0;\n  }\n\n  .filter-select-sm,\n  .filter-select-md,\n  .filter-select-lg {\n    max-width: none !important;\n  }\n\n  #supermanagers > .d-flex.flex-wrap.gap-2.align-items-center.mb-3 .form-check-inline {\n    margin-right: 0;\n    font-size: 0.8rem !important;\n  }\n\n  .sm-card {\n    border-width: 2px;\n  }\n\n  .sm-card-controls {\n    gap: 2px;\n    padding: 2px 4px;\n  }\n\n  .sm-elements {\n    top: 3px;\n    right: 3px;\n  }\n\n  .sm-el {\n    width: 16px;\n    height: 16px;\n    font-size: 0.5rem;\n  }\n\n  .sm-unlock-btn {\n    font-size: 1rem;\n  }\n\n  .sm-max-btn,\n  .sm-p30-btn,\n  .sm-chrono-btn,\n  .sm-tl-btn {\n    font-size: 0.58rem;\n    padding: 1px 3px;\n  }\n\n  .sm-fragment-bar {\n    height: 14px;\n    line-height: 14px;\n  }\n}\n\n@media (max-width: 576px) {\n  .tierlist-label {\n    width: 40px;\n    min-width: 40px;\n    font-size: 1rem;\n  }\n  .tierlist-item {\n    width: 50px;\n    height: 50px;\n    border-width: 2px;\n  }\n  .tierlist-items {\n    min-height: 56px;\n    padding: 4px;\n    gap: 3px;\n  }\n  .tierlist-pool {\n    padding: 6px;\n    gap: 3px;\n  }\n}\n"
