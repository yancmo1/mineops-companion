          "content": {
            "size": 6246,
            "mimeType": "text/html",
            "text": "<div class=\"tab-pane fade show active\" id=\"supermanagers\" role=\"tabpanel\" aria-labelledby=\"sm-tab\">\n  <div id=\"smShareBanner\" class=\"sm-share-banner\" hidden>\n    <div class=\"sm-share-banner-text\">\n      <span id=\"smShareBannerTitle\"></span>\n      <span class=\"sm-share-banner-meta\" id=\"smShareBannerMeta\"></span>\n    </div>\n    <a class=\"sm-share-banner-cta\" id=\"smShareBannerCta\" href=\"#sm\"> Make your own &rarr; </a>\n  </div>\n  <div class=\"d-flex flex-wrap gap-2 align-items-center mb-3\">\n    <div class=\"filter-search-wrap\">\n      <input\n        type=\"text\"\n        class=\"form-control form-control-sm\"\n        id=\"smSearch\"\n        placeholder=\"Search by name...\"\n        aria-label=\"Search super managers by name\"\n      />\n      <span\n        id=\"smSearchClear\"\n        style=\"\n          display: none;\n          position: absolute;\n          right: 6px;\n          top: 50%;\n          transform: translateY(-50%);\n          cursor: pointer;\n          color: var(--content-text-muted);\n          font-size: 0.85rem;\n          line-height: 1;\n        \"\n        >&times;</span\n      >\n    </div>\n    <select\n      class=\"form-select form-select-sm filter-select-sm\"\n      id=\"smFilterArea\"\n      aria-label=\"Filter by area\"\n    >\n      <option value=\"\">All Areas</option>\n      <option value=\"mineshaft\">Mineshaft</option>\n      <option value=\"elevator\">Elevator</option>\n      <option value=\"warehouse\">Warehouse</option>\n    </select>\n    <select\n      class=\"form-select form-select-sm filter-select-sm\"\n      id=\"smFilterRarity\"\n      aria-label=\"Filter by rarity\"\n    >\n      <option value=\"\">All Rarities</option>\n      <option value=\"legendary\">Legendary</option>\n      <option value=\"epic\">Epic</option>\n      <option value=\"rare\">Rare</option>\n      <option value=\"common\">Common</option>\n    </select>\n    <select\n      class=\"form-select form-select-sm filter-select-sm\"\n      id=\"smFilterElement\"\n      aria-label=\"Filter by element\"\n    >\n      <option value=\"\">All Elements</option>\n      <option value=\"flame\">Flame</option>\n      <option value=\"frost\">Frost</option>\n      <option value=\"nature\">Nature</option>\n      <option value=\"wind\">Wind</option>\n      <option value=\"water\">Water</option>\n      <option value=\"dark\">Dark</option>\n      <option value=\"light\">Light</option>\n      <option value=\"sand\">Sand</option>\n      <option value=\"order\">Order</option>\n      <option value=\"chaos\">Chaos</option>\n    </select>\n    <select\n      class=\"form-select form-select-sm filter-select-md\"\n      id=\"smFilterStatus\"\n      aria-label=\"Filter by status\"\n    >\n      <option value=\"\">All Status</option>\n      <option value=\"unlocked\">Unlocked</option>\n      <option value=\"locked\">Locked</option>\n      <option value=\"chrono-included\">Chrono Included</option>\n      <option value=\"chrono-excluded\">Chrono Excluded</option>\n      <option value=\"tl-included\">TL Included</option>\n      <option value=\"tl-excluded\">TL Excluded</option>\n    </select>\n    <label class=\"form-check form-check-inline mb-0\" style=\"font-size: 0.85rem\">\n      <input class=\"form-check-input\" type=\"checkbox\" id=\"smFilterIncome\" /> MIF / CIF\n    </label>\n    <label class=\"form-check form-check-inline mb-0\" style=\"font-size: 0.85rem\">\n      <input class=\"form-check-input\" type=\"checkbox\" id=\"smFilterMSUCR\" /> MSUCR\n    </label>\n    <select\n      class=\"form-select form-select-sm filter-select-lg\"\n      id=\"smFilterPassive\"\n      aria-label=\"Filter by passive ability\"\n    >\n      <option value=\"\">All Passives</option>\n      <optgroup label=\"Speed Boosts\">\n        <option value=\"EMSB\">Movement Speed</option>\n        <option value=\"GWSB\">Walking Speed</option>\n        <option value=\"MSB\">Mining Speed</option>\n        <option value=\"MLSB\">Loading &amp; Movement Speed</option>\n        <option value=\"WMSB\">Mining &amp; Walking Speed</option>\n        <option value=\"WWLSB\">Warehouse Walking &amp; Loading</option>\n      </optgroup>\n      <optgroup label=\"Cost Reduction\">\n        <option value=\"CR\">Upgrade Cost</option>\n        <option value=\"MSUCR\">Mineshaft Unlock Cost</option>\n        <option value=\"BUCR\">Barrier Unlock Cost</option>\n      </optgroup>\n      <optgroup label=\"Income\">\n        <option value=\"MIF\">Mine Income Factor</option>\n        <option value=\"CIF\">Continent Income</option>\n        <option value=\"IC\">Idle Cash</option>\n      </optgroup>\n      <optgroup label=\"Beam\">\n        <option value=\"EBEAM\">Elevator Beam</option>\n        <option value=\"MSBEAM\">Mineshaft Beam</option>\n      </optgroup>\n    </select>\n    <select class=\"form-select form-select-sm filter-select-md\" id=\"smSort\" aria-label=\"Sort order\">\n      <option value=\"\">Sort: By Rarity (A&#8211;Z)</option>\n      <option value=\"ingame\">In-game order</option>\n      <option value=\"rank-up\">Closest to Rank Up</option>\n      <option value=\"element\">By Element</option>\n      <option value=\"area\">By Area</option>\n      <option value=\"level-desc\">Level (high&#8594;low)</option>\n      <option value=\"level-asc\">Level (low&#8594;high)</option>\n    </select>\n  </div>\n  <div\n    class=\"mb-3 d-flex flex-wrap align-items-center gap-2\"\n    style=\"color: var(--content-text-muted); font-size: 0.9rem\"\n  >\n    <span id=\"smStats\"></span>\n    <button\n      class=\"btn btn-sm btn-outline-secondary\"\n      style=\"font-size: 0.75rem; padding: 1px 8px\"\n      id=\"smToggleBtn\"\n    >\n      Unlock All\n    </button>\n    <button\n      class=\"btn btn-sm btn-outline-secondary\"\n      style=\"font-size: 0.75rem; padding: 1px 8px\"\n      id=\"smMaxAllBtn\"\n    >\n      Max All\n    </button>\n    <button class=\"btn btn-sm btn-primary ms-auto\" id=\"smShareBtn\">\n      <span aria-hidden=\"true\">&#128279;</span> Share Link\n    </button>\n  </div>\n  <div class=\"row g-3\" id=\"smGrid\"></div>\n  <div id=\"smShareEssencePanel\" class=\"sm-share-essence-panel\" hidden></div>\n  <div class=\"d-flex gap-2 mt-3\" id=\"smTrackerActions\">\n    <button class=\"btn btn-sm btn-outline-secondary\" id=\"smExportBtn\">Export JSON</button>\n    <label class=\"btn btn-sm btn-outline-secondary mb-0\">\n      Import JSON\n      <input type=\"file\" id=\"smImportFile\" accept=\".json\" style=\"display: none\" />\n    </label>\n  </div>\n  <div id=\"smShareError\" class=\"sm-share-error\" hidden></div>\n</div>\n\n<!-- Progress Tracker Tab -->\n"
          },
