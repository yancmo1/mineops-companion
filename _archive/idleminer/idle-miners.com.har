            "text": ".fm-methodology-wrap {\n  padding-top: 0.15rem;\n}\n\n.fm-calculator-pane #fmPanelMethodology .card-body {\n  font-size: 0.96rem;\n  line-height: 1.7;\n}\n\n.fm-calculator-pane #fmPanelMethodology details {\n  margin-top: 10px;\n}\n\n.fm-calculator-pane #fmPanelMethodology summary {\n  color: var(--accent-primary);\n  font-weight: 500;\n  cursor: pointer;\n}\n\n.fm-calculator-pane #fmPanelMethodology code {\n  padding: 2px 6px;\n  background: var(--content-bg-alt);\n  border-radius: 4px;\n  font-size: 0.88em;\n}\n\n.fm-calculator-pane #fmPanelMethodology .formula {\n  margin: 10px 0;\n  padding: 10px 14px;\n  background: var(--content-bg-alt);\n  border-left: 3px solid var(--rarity-common);\n  border-radius: 0 6px 6px 0;\n  font-family: 'Courier New', monospace;\n}\n\n.fm-calculator-pane #methodologyChartContainer {\n  position: relative;\n  height: 320px;\n  margin: 16px 0;\n  padding: 8px;\n  background: var(--content-bg-alt);\n  border-radius: 14px;\n}\n\n@media (min-width: 992px) {\n  .fm-results-card {\n    position: sticky;\n    top: 1rem;\n  }\n}\n\n@media (max-width: 767px) {\n  #mainTabs {\n    flex-wrap: nowrap;\n    overflow-x: auto;\n    overflow-y: hidden;\n    padding-bottom: 0.35rem;\n    scrollbar-width: none;\n  }\n\n  #mainTabs::-webkit-scrollbar {\n    display: none;\n  }\n\n  #mainTabs .nav-item {\n    flex: 0 0 auto;\n  }\n\n  .fm-hero {\n    flex-direction: column;\n    padding: 1.15rem 1rem 1rem;\n  }\n\n  .fm-shell {\n    border-radius: 18px;\n  }\n\n  .fm-title {\n    font-size: 1.5rem;\n  }\n\n  .fm-lead {\n    font-size: 0.92rem;\n  }\n\n  .fm-view-switcher {\n    width: 100%;\n    justify-content: flex-start;\n    overflow-x: auto;\n    flex-wrap: nowrap;\n    padding-bottom: 0.2rem;\n    scrollbar-width: none;\n  }\n\n  .fm-view-switcher::-webkit-scrollbar {\n    display: none;\n  }\n\n  .fm-view-btn {\n    min-width: 0;\n    flex: 0 0 auto;\n  }\n\n  .fm-info-strip {\n    padding: 0.75rem 1rem;\n    font-size: 0.82rem;\n  }\n\n  .fm-info-divider {\n    display: none;\n  }\n\n  .fm-body {\n    padding: 0.9rem;\n  }\n\n  .fm-results-hint {\n    display: none;\n  }\n\n  .fm-calculator-pane .card {\n    border-radius: 16px;\n  }\n\n  .fm-calculator-pane .card-header {\n    padding: 0.85rem 1rem;\n  }\n\n  .fm-calculator-pane .card-body {\n    padding: 1rem;\n  }\n\n  .fm-calculator-pane .alert {\n    padding: 0.85rem 0.95rem;\n  }\n\n  .fm-calculator-pane .result-item {\n    padding: 0.8rem 0.85rem;\n  }\n\n  .fm-calculator-pane .result-value {\n    font-size: 1.08rem;\n    word-break: break-word;\n  }\n\n  .fm-calculator-pane .pass-checkbox {\n    padding: 0.75rem;\n  }\n\n  .fm-calculator-pane .data-table {\n    font-size: 0.76rem;\n  }\n\n  .fm-calculator-pane .data-table th,\n  .fm-calculator-pane .data-table td {\n    padding: 0.45rem 0.5rem;\n  }\n\n  .fm-calculator-pane .breakpoint-line {\n    font-size: 0.66rem;\n    padding: 0.3rem 0.45rem;\n  }\n\n  .fm-calculator-pane #fmPanelData .card-header,\n  .fm-calculator-pane .fm-results-card .card-header {\n    flex-wrap: wrap;\n    gap: 0.45rem;\n    align-items: flex-start !important;\n  }\n\n  .fm-calculator-pane #fmPanelMethodology .formula {\n    overflow-x: auto;\n    font-size: 0.82rem;\n  }\n\n  #edgarOffers {\n    max-width: none !important;\n  }\n\n  .fm-calculator-pane #fcChartContainer {\n    height: 190px;\n    padding: 6px;\n  }\n\n  .fm-calculator-pane #methodologyChartContainer {\n    height: 240px;\n    padding: 6px;\n  }\n}\n\n@media (max-width: 575.98px) {\n  #calcForm .row.g-2 > .col-6 {\n    width: 100%;\n  }\n\n  .fm-view-btn {\n    font-size: 0.82rem;\n  }\n}\n"
