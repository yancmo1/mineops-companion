          "cookies": [],
          "content": {
            "size": 7376,
            "mimeType": "application/javascript",
            "text": "/* Progress Tracker — preset stage definitions.\n\n   Extracted from progress-tracker.js to keep each source file under the\n   line budget (tests/meta/test_line_budget.py). Global-scope, same as the\n   tracker engine; loaded immediately AFTER progress-tracker.js (see init.js\n   LAZY_MODULES['progress-tab'].src) so the predicate helpers + progressPromoTarget\n   it references are already defined when this array is evaluated. */\n\nvar PROGRESS_STAGES = [\n  {\n    id: 1,\n    title: 'Get all rare MIFs to P30',\n    subtitle:\n      'Foundation: every rare-tier Mine Income Factor SM at promo 3. SMs marked optional below are paywalled behind the paid Growth Fund — recommended but optional.',\n    filter: function (sm) {\n      return sm.rarity === 'rare' && progressHasPassive(sm, 'MIF');\n    },\n    target: progressPromoTarget(3),\n    quantifier: 'all',\n    targetLabel: 'P30',\n    optionalIds: ['1dl3'],\n    optionalNote: 'Optional · Growth Fund',\n  },\n  {\n    id: 2,\n    title: 'Get all mineshaft epic P30 MIF & CIF managers',\n    subtitle:\n      'Every mineshaft epic whose MIF or CIF activates at P30. P50-unlock epics are pushed to stage 5.',\n    filter: function (sm) {\n      if (sm.area !== 'mineshaft' || sm.rarity !== 'epic') return false;\n      var p = progressGetMifOrCif(sm);\n      return !!p && p.promoReq <= 3;\n    },\n    target: progressPromoTarget(3),\n    quantifier: 'all',\n    targetLabel: 'P30',\n  },\n  {\n    id: 3,\n    title: 'Get one warehouse P30 MIF/CIF manager',\n    subtitle:\n      'Any warehouse SM whose MIF or CIF activates at P30. P50-unlock warehouse income SMs are handled later.',\n    filter: function (sm) {\n      if (sm.area !== 'warehouse') return false;\n      var p = progressGetMifOrCif(sm);\n      return !!p && p.promoReq <= 3;\n    },\n    target: progressPromoTarget(3),\n    quantifier: 'any1',\n    targetLabel: 'P30',\n  },\n  {\n    id: 4,\n    title: 'Get all mineshaft P10 MSUCR managers',\n    subtitle:\n      'Every mineshaft SM whose MSUCR activates at promo 1. This is the quick early unlock-cost foundation before the later P30 and P50 MSUCR stages.',\n    filter: function (sm) {\n      if (sm.area !== 'mineshaft') return false;\n      var p = progressGetPassive(sm, 'MSUCR');\n      return !!p && p.promoReq === 1;\n    },\n    target: progressPromoTarget(1),\n    quantifier: 'all',\n    targetLabel: 'P10',\n  },\n  {\n    id: 5,\n    title: 'Get all mineshaft epic P50 MIF & CIF managers',\n    subtitle:\n      'Only the mineshaft epics whose MIF or CIF activates at P50. The earlier P30-unlock epics from stage 2 buy nothing extra past P30.',\n    filter: progressIsMineshaftEpicP50MifCif,\n    target: progressPromoTarget(5),\n    quantifier: 'all',\n    targetLabel: 'P50',\n  },\n  {\n    id: 6,\n    title: 'Get all non-legendary mineshaft P30 MSUCR managers',\n    subtitle:\n      'Every non-legendary mineshaft SM whose MSUCR activates at promo 3. P50-unlock MSUCRs are pushed to stage 7 instead.',\n    filter: function (sm) {\n      if (sm.area !== 'mineshaft' || sm.rarity === 'legendary') return false;\n      var p = progressGetPassive(sm, 'MSUCR');\n      return !!p && p.promoReq === 3;\n    },\n    target: progressPromoTarget(3),\n    quantifier: 'all',\n    targetLabel: 'P30',\n  },\n  {\n    id: 7,\n    title: 'Get all non-legendary mineshaft P50 MSUCR managers',\n    subtitle:\n      'Every non-legendary mineshaft SM whose MSUCR activates at promo 5 — these go all the way.',\n    filter: progressIsNonLegendaryMineshaftP50Msucr,\n    target: progressPromoTarget(5),\n    quantifier: 'all',\n    targetLabel: 'P50',\n  },\n  {\n    id: 8,\n    title: 'Get all legendary mineshaft MIF & CIF managers',\n    subtitle: 'Push every legendary mineshaft income SM to the promo where its MIF or CIF unlocks.',\n    filter: progressIsLegendaryMineshaftMifCif,\n    target: function (sm, st) {\n      var p = progressGetMifOrCif(sm);\n      if (!p) return false;\n      if (!st || !st.unlocked) return false;\n      return (st.promoted || 0) >= p.promoReq;\n    },\n    quantifier: 'all',\n    targetLabel: function (sm) {\n      var p = progressGetMifOrCif(sm);\n      return p ? 'P' + p.promoReq * 10 : '';\n    },\n  },\n  {\n    id: 9,\n    title: 'Get all legendary mineshaft P30 MSUCR managers',\n    subtitle:\n      'Every legendary mineshaft SM whose MSUCR activates at promo 3. P50-unlock legendaries are handled in stage 10.',\n    filter: function (sm) {\n      if (sm.area !== 'mineshaft' || sm.rarity !== 'legendary') return false;\n      var p = progressGetPassive(sm, 'MSUCR');\n      return !!p && p.promoReq === 3;\n    },\n    target: progressPromoTarget(3),\n    quantifier: 'all',\n    targetLabel: 'P30',\n  },\n  {\n    id: 10,\n    title: 'Get all legendary mineshaft P50 MSUCR managers',\n    subtitle:\n      'Every legendary mineshaft SM whose MSUCR activates at promo 5 — these need full max.',\n    filter: progressIsLegendaryMineshaftP50Msucr,\n    target: progressPromoTarget(5),\n    quantifier: 'all',\n    targetLabel: 'P50',\n  },\n  {\n    id: 11,\n    title: 'Get one legendary elevator P50 MIF/CIF manager',\n    subtitle: 'Any legendary elevator SM with MIF or CIF, fully maxed at promo 5.',\n    filter: function (sm) {\n      return sm.area === 'elevator' && sm.rarity === 'legendary' && progressHasMifOrCif(sm);\n    },\n    target: progressPromoTarget(5),\n    quantifier: 'any1',\n    targetLabel: 'P50',\n  },\n  {\n    id: 12,\n    title: 'Get one legendary warehouse P50 MIF/CIF manager',\n    subtitle: 'Any legendary warehouse SM with MIF or CIF, fully maxed at promo 5.',\n    filter: function (sm) {\n      return sm.area === 'warehouse' && sm.rarity === 'legendary' && progressHasMifOrCif(sm);\n    },\n    target: progressPromoTarget(5),\n    quantifier: 'any1',\n    targetLabel: 'P50',\n  },\n  {\n    id: 13,\n    title: 'Get all remaining mineshaft MIF & CIF managers',\n    subtitle:\n      'Finish the remaining mineshaft income roster at P50. This catches the rare MIFs, the early-unlock epic income managers, and any other mineshaft MIF/CIF rows not already maxed by stages 5, 8, or 10.',\n    filter: progressIsRemainingMineshaftMifCif,\n    target: progressPromoTarget(5),\n    quantifier: 'all',\n    targetLabel: 'P50',\n  },\n  {\n    id: 14,\n    title: 'Get all remaining MSUCR managers',\n    subtitle:\n      'Finish the remaining MSUCR roster at P50. Eligible rows can span common through legendary, and some current legendary MSUCR managers are absent here because earlier max stages already cover them.',\n    filter: progressIsRemainingMsucr,\n    target: progressPromoTarget(5),\n    quantifier: 'all',\n    targetLabel: 'P50',\n  },\n  {\n    id: 15,\n    title: 'Completionist: max every remaining manager to P50',\n    subtitle:\n      '100% box-ticking stage. This sweeps up managers not otherwise required by the all-manager max stages, including extra warehouse/elevator MIF/CIF rows. Many are not practical to max in normal play.',\n    filter: function (sm) {\n      if (progressIsMineshaftEpicP50MifCif(sm)) return false;\n      if (progressIsNonLegendaryMineshaftP50Msucr(sm)) return false;\n      if (progressIsLegendaryMineshaftMifCif(sm)) return false;\n      if (progressIsLegendaryMineshaftP50Msucr(sm)) return false;\n      if (progressIsRemainingMineshaftMifCif(sm)) return false;\n      if (progressIsRemainingMsucr(sm)) return false;\n      return true;\n    },\n    target: progressPromoTarget(5),\n    quantifier: 'all',\n    targetLabel: 'P50',\n  },\n];\n"
          },
          "redirectURL": "",
