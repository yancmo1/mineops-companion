          "content": {
            "size": 3451,
            "mimeType": "text/html",
            "text": "<div class=\"tab-pane fade\" id=\"chronoplanner\" role=\"tabpanel\" aria-labelledby=\"chrono-tab\">\n  <div class=\"d-flex flex-wrap gap-2 align-items-center mb-2\" id=\"chronoSchedBar\" hidden>\n    <span style=\"font-size: 0.8rem; color: var(--content-text-muted)\">Chrono Schedule:</span>\n    <select\n      id=\"chronoSchedSelect\"\n      class=\"form-select form-select-sm\"\n      style=\"width: auto; font-size: 0.8rem\"\n    ></select>\n    <button class=\"btn btn-sm btn-outline-success\" id=\"chronoSchedApplyBtn\">\n      Load Chrono Layout\n    </button>\n    <span\n      id=\"chronoSchedStatus\"\n      style=\"font-size: 0.75rem; color: var(--content-text-muted)\"\n    ></span>\n  </div>\n  <div class=\"d-flex flex-wrap gap-2 align-items-center mb-3\">\n    <label class=\"d-flex align-items-center gap-1\" style=\"font-size: 0.8rem\">\n      E:\n      <select class=\"chrono-el-select\" id=\"chronoElEvator\" aria-label=\"Elevator element\">\n        <option value=\"flame\">Flame</option>\n        <option value=\"frost\">Frost</option>\n        <option value=\"nature\" selected>Nature</option>\n        <option value=\"wind\">Wind</option>\n        <option value=\"water\">Water</option>\n        <option value=\"dark\">Dark</option>\n        <option value=\"light\">Light</option>\n        <option value=\"sand\">Sand</option>\n        <option value=\"order\">Order</option>\n        <option value=\"chaos\">Chaos</option>\n      </select>\n    </label>\n    <label class=\"d-flex align-items-center gap-1\" style=\"font-size: 0.8rem\">\n      W:\n      <select class=\"chrono-el-select\" id=\"chronoElWarehouse\" aria-label=\"Warehouse element\">\n        <option value=\"flame\">Flame</option>\n        <option value=\"frost\">Frost</option>\n        <option value=\"nature\">Nature</option>\n        <option value=\"wind\">Wind</option>\n        <option value=\"water\" selected>Water</option>\n        <option value=\"dark\">Dark</option>\n        <option value=\"light\">Light</option>\n        <option value=\"sand\">Sand</option>\n        <option value=\"order\">Order</option>\n        <option value=\"chaos\">Chaos</option>\n      </select>\n    </label>\n    <span style=\"font-size: 0.8rem; color: var(--content-text-muted)\">MS Pattern:</span>\n    <input\n      type=\"number\"\n      id=\"chronoPatternLen\"\n      min=\"1\"\n      max=\"20\"\n      value=\"4\"\n      style=\"width: 3em; font-size: 0.8rem\"\n    />\n    <span\n      id=\"chronoPatternSelects\"\n      style=\"display: inline-flex; flex-wrap: wrap; gap: 2px; align-items: center\"\n    ></span>\n    <label style=\"font-size: 0.75rem; margin: 0 6px; cursor: pointer\">\n      <input type=\"checkbox\" id=\"chronoPrioMsucr\" />\n      Prioritize MSUCR over MIF/CIF\n    </label>\n    <button class=\"btn btn-sm btn-outline-primary\" id=\"chronoAutoAssignBtn\">Auto Assign</button>\n    <button class=\"btn btn-sm btn-outline-secondary\" id=\"chronoClearBtn\">Clear All</button>\n    <span id=\"chronoSummary\" style=\"font-size: 0.8rem; color: var(--content-text-muted)\"></span>\n  </div>\n  <div style=\"font-size: 0.72rem; color: var(--content-text-muted); margin-bottom: 6px\">\n    Locked Super Managers are hidden for simplicity; excluded ones appear greyed at the bottom of\n    each list.\n  </div>\n  <div class=\"row\">\n    <div class=\"col-md-8 chrono-grid-col\">\n      <div class=\"chrono-grid-wrap\" id=\"chronoGrid\"></div>\n    </div>\n    <div class=\"col-md-4\" id=\"chronoPanel\">\n      <div class=\"text-muted text-center py-4\" style=\"font-size: 0.85rem\">\n        Click a slot to assign a Super Manager\n      </div>\n    </div>\n  </div>\n</div>\n"
          },
