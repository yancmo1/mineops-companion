            "mimeType": "text/css",
            "text": "/* Stella's Lucky Elevator — tab styles\n   Namespaced .stella-* so nothing leaks across tabs. */\n\n#stellaelevator {\n  padding-top: 1rem;\n  --stella-surface: var(--content-bg, #faf8f5);\n  --stella-surface-raised: #fff;\n  --stella-surface-muted: var(--content-bg-alt, #f2efe9);\n  --stella-hero-end: #fff;\n  --stella-text: var(--content-text, #2c2519);\n  --stella-text-muted: var(--content-text-muted, #6b6259);\n  --stella-heading: #183153;\n  --stella-subheading: #1e3b5c;\n  --stella-soft-text: #354a60;\n  --stella-border: rgba(188, 204, 220, 0.85);\n  --stella-border-strong: rgba(188, 204, 220, 0.9);\n  --stella-shadow: rgba(34, 58, 94, 0.05);\n  --stella-shadow-soft: rgba(34, 58, 94, 0.04);\n  --stella-purple-bg: #f3f0fa;\n  --stella-purple-text: #4a2d76;\n  --stella-warning-bg: #fff3e0;\n  --stella-warning-text: #783804;\n  --stella-warning-border: rgba(217, 119, 6, 0.35);\n  --stella-success-bg: #e8f5ec;\n  --stella-success-text: #1e5031;\n  --stella-success-border: rgba(47, 158, 68, 0.35);\n  --stella-info-bg: #e7f0fb;\n  --stella-info-text: #103a6b;\n  --stella-info-border: rgba(33, 95, 170, 0.3);\n  --stella-danger-bg: #fdece8;\n  --stella-danger-text: #7a2415;\n  --stella-danger-border: rgba(179, 52, 27, 0.35);\n  --stella-neutral-bg: #f3f5f9;\n  --stella-neutral-text: #354a60;\n  --stella-neutral-border: rgba(120, 130, 145, 0.35);\n  --stella-bar-bg: #f0f3f7;\n  --stella-bar-fill-start: #6aa84f;\n  --stella-bar-fill-end: #38761d;\n  --stella-result-bg: #f7f4ec;\n  --stella-result-label: #8a6a1a;\n  --stella-result-border: rgba(212, 169, 55, 0.35);\n  --stella-safe-bg: #f0f8f3;\n  --stella-safe-text: #2a4a30;\n  --stella-safe-border: rgba(47, 158, 68, 0.4);\n  --stella-risk-bg: #fff7ea;\n  --stella-risk-head-bg: #fbeecf;\n  --stella-risk-text: #6b4e0d;\n  --stella-risk-border: rgba(245, 166, 35, 0.4);\n  --stella-set-bg: #fdf7e6;\n  --stella-bomb-bg: #fdece8;\n  --stella-bomb-text: #b3341b;\n}\n\n[data-theme='dark'] #stellaelevator {\n  --stella-surface-raised: var(--content-bg, #282014);\n  --stella-hero-end: var(--content-bg-alt, #2a2317);\n  --stella-heading: var(--content-text, #e8e6e3);\n  --stella-subheading: var(--content-text, #e8e6e3);\n  --stella-soft-text: var(--content-text-muted, #aaa398);\n  --stella-border: var(--border-subtle, rgba(255, 255, 255, 0.08));\n  --stella-border-strong: var(--border-strong, rgba(255, 255, 255, 0.16));\n  --stella-shadow: rgba(0, 0, 0, 0.35);\n  --stella-shadow-soft: rgba(0, 0, 0, 0.25);\n  --stella-purple-bg: #2f2538;\n  --stella-purple-text: #dec8ff;\n  --stella-warning-bg: #3a2a16;\n  --stella-warning-text: #ffd18a;\n  --stella-warning-border: rgba(246, 173, 52, 0.35);\n  --stella-success-bg: var(--accent-primary-light, #1d2d25);\n  --stella-success-text: #b8f2c4;\n  --stella-success-border: rgba(105, 210, 125, 0.35);\n  --stella-info-bg: #192b3d;\n  --stella-info-text: #b7dcff;\n  --stella-info-border: rgba(84, 164, 217, 0.35);\n  --stella-danger-bg: #3d1f1a;\n  --stella-danger-text: #ffb2a8;\n  --stella-danger-border: rgba(216, 92, 79, 0.35);\n  --stella-neutral-bg: var(--content-bg-alt, #2a2317);\n  --stella-neutral-text: var(--content-text-muted, #aaa398);\n  --stella-neutral-border: rgba(255, 255, 255, 0.12);\n  --stella-bar-bg: #3b3328;\n  --stella-bar-fill-start: #69d27d;\n  --stella-bar-fill-end: #3b8a4c;\n  --stella-result-bg: #332817;\n  --stella-result-label: #f1cd72;\n  --stella-result-border: rgba(216, 177, 73, 0.3);\n  --stella-safe-bg: #1d2d25;\n  --stella-safe-text: #c9f4d2;\n  --stella-safe-border: rgba(105, 210, 125, 0.35);\n  --stella-risk-bg: #382814;\n  --stella-risk-head-bg: #453115;\n  --stella-risk-text: #ffd680;\n  --stella-risk-border: rgba(246, 173, 52, 0.35);\n  --stella-set-bg: #382814;\n  --stella-bomb-bg: #3d1f1a;\n  --stella-bomb-text: #ffb2a8;\n}\n\n.stella-shell {\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n}\n\n.stella-hero {\n  padding: 1rem 1.25rem;\n  background:\n    radial-gradient(circle at top left, rgba(245, 200, 126, 0.18), transparent 38%),\n    radial-gradient(circle at top right, rgba(180, 120, 230, 0.14), transparent 40%),\n    linear-gradient(180deg, var(--stella-surface) 0%, var(--stella-hero-end) 100%);\n  border: 1px solid var(--stella-border-strong);\n  border-radius: 18px;\n}\n\n.stella-eyebrow {\n  margin-bottom: 0.35rem;\n  color: #8a4bb8;\n  font-size: 0.75rem;\n  font-weight: 700;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n}\n\n.stella-title {\n  margin: 0;\n  color: var(--stella-heading);\n  font-family: 'Orbitron', 'Cinzel', serif;\n  font-size: 1.5rem;\n  font-weight: 900;\n  line-height: 1.2;\n}\n\n.stella-lead {\n  margin: 0.4rem 0 0;\n  color: var(--stella-soft-text);\n  font-size: 0.92rem;\n  line-height: 1.5;\n}\n\n.stella-card {\n  padding: 1rem 1.1rem;\n  background: var(--stella-surface-raised);\n  border: 1px solid var(--stella-border);\n  border-radius: 16px;\n  box-shadow: 0 6px 18px var(--stella-shadow);\n}\n\n.stella-card-title {\n  margin: 0 0 0.75rem;\n  color: var(--stella-heading);\n  font-size: 1.05rem;\n  font-weight: 700;\n}\n\n/* ---------- Mechanics ---------- */\n\n.stella-mech-list {\n  padding-left: 1.1rem;\n  color: var(--stella-soft-text);\n  font-size: 0.92rem;\n  line-height: 1.55;\n}\n\n.stella-mech-subhead {\n  color: var(--stella-subheading);\n  font-size: 0.88rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n}\n\n.stella-continue-table {\n  --bs-border-color: var(--stella-border);\n  --bs-table-bg: transparent;\n  --bs-table-color: var(--stella-text);\n  font-size: 0.9rem;\n}\n\n.stella-continue-table th {\n  background: var(--stella-neutral-bg);\n  color: var(--stella-subheading);\n  text-align: center;\n}\n\n.stella-continue-table td {\n  text-align: center;\n}\n\n.stella-mech-note {\n  color: var(--stella-text-muted);\n  font-size: 0.82rem;\n}\n\n/* ---------- Calculator ---------- */\n\n.stella-calc-form {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n  gap: 0.9rem 1rem;\n  align-items: end;\n}\n\n.stella-calc-form .form-label {\n  margin-bottom: 0.3rem;\n  color: var(--stella-subheading);\n  font-size: 0.82rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n}\n\n.stella-calc-form .stella-calc-express-wrap {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  padding-bottom: 0.45rem;\n  font-size: 0.95rem;\n  color: var(--stella-soft-text);\n}\n\n.stella-result {\n  margin-top: 1rem;\n}\n\n.stella-budget-block {\n  margin-top: 0.25rem;\n  padding: 0.75rem 0.9rem 0.5rem;\n  background: linear-gradient(180deg, var(--stella-purple-bg) 0%, var(--stella-surface-raised) 60%);\n  border: 1px solid rgba(138, 75, 184, 0.28);\n  border-radius: 12px;\n}\n\n.stella-budget-title {\n  margin: 0 0 0.2rem;\n  color: var(--stella-purple-text);\n  font-size: 0.82rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n}\n\n.stella-budget-sub {\n  margin: 0 0 0.6rem;\n  color: var(--stella-text-muted);\n  font-size: 0.82rem;\n}\n\n.stella-budget-need {\n  margin-top: 0.7rem;\n  padding: 0.55rem 0.8rem;\n  background: var(--stella-warning-bg);\n  border: 1px solid var(--stella-warning-border);\n  border-radius: 8px;\n  color: var(--stella-warning-text);\n  font-size: 0.9rem;\n}\n\n.stella-budget-ok {\n  margin-top: 0.7rem;\n  padding: 0.55rem 0.8rem;\n  background: var(--stella-success-bg);\n  border: 1px solid var(--stella-success-border);\n  border-radius: 8px;\n  color: var(--stella-success-text);\n  font-size: 0.9rem;\n}\n\n/* ---------- Per-floor probability bars ---------- */\n\n.stella-floor-probs {\n  margin-top: 1rem;\n  padding: 0.85rem 1rem 0.95rem;\n  background: var(--stella-surface-raised);\n  border: 1px solid var(--stella-border);\n  border-radius: 12px;\n}\n\n.stella-floor-probs-title {\n  margin: 0 0 0.6rem;\n  color: var(--stella-subheading);\n  font-size: 0.82rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n}\n\n.stella-fp-list {\n  display: grid;\n  gap: 0.3rem;\n}\n\n.stella-fp-row {\n  display: grid;\n  grid-template-columns: 90px 1fr 60px;\n  align-items: center;\n  gap: 0.6rem;\n  font-size: 0.88rem;\n  color: var(--stella-soft-text);\n}\n\n.stella-fp-label {\n  font-weight: 600;\n}\n\n.stella-fp-bar {\n  position: relative;\n  height: 10px;\n  background: var(--stella-bar-bg);\n  border-radius: 999px;\n  overflow: hidden;\n}\n\n.stella-fp-fill {\n  height: 100%;\n  background: linear-gradient(\n    90deg,\n    var(--stella-bar-fill-start) 0%,\n    var(--stella-bar-fill-end) 100%\n  );\n  border-radius: 999px;\n}\n\n.stella-fp-value {\n  text-align: right;\n  font-family: 'Orbitron', monospace;\n  font-weight: 700;\n  color: var(--stella-text);\n}\n"
          },
